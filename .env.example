# KIS(한국투자증권) Open API 자격증명 템플릿.
# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 커밋되지 않습니다.
# 값은 KIS Developers(apiportal.koreainvestment.com)에서 발급받습니다.

# --- 실전투자 ---
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCT_STOCK=          # 실전 계좌번호 앞 8자리 (CANO)
KIS_HTS_ID=

# --- 모의투자 ---
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_STOCK=         # 모의투자 계좌번호 앞 8자리 (CANO)

# --- 엔드포인트 (기본값 그대로 사용 가능) ---
KIS_URL_REST=https://openapi.koreainvestment.com:9443
KIS_URL_REST_PAPER=https://openapivts.koreainvestment.com:29443
KIS_URL_WS=ws://ops.koreainvestment.com:21000
KIS_URL_WS_PAPER=ws://ops.koreainvestment.com:31000

# --- KRX(한국거래소) Open API — ETF/ETN 전체 목록 조회 전용 ---
# openapi.krx.co.kr 에서 발급 (KIS와 별개 기관)
KRX_AUTH_KEY=

# --- 데이터 저장 위치 (선택) ---
# 런타임 데이터(로그/상태/캐시/생성물)는 소스 트리 밖 DATA_ROOT에 쌓입니다.
# 기본값은 ~/kis_arb_data 이며, 바꾸려면 아래 변수를 사용합니다.
#   ※ 이 변수는 .env가 아니라 OS/launchd 환경변수로 읽힙니다(etf_arb/paths.py가
#     os.environ에서 직접 조회). .env에 적어도 dotenv로만 로드되어 무시되므로,
#     실제로 바꾸려면 셸 export 또는 launchd plist의 EnvironmentVariables에 설정하세요.
# KIS_ARB_DATA_DIR=/absolute/path/to/data
